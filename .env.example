# Copy to .env:  cp .env.example .env  (docker compose reads it; it is optional)

# ---- service ----
LOG_LEVEL=INFO
MAX_UPLOAD_MB=50
DEMO_PAYMENTS=5000
DEMO_SEED=42
# Local runs only; the Docker image sets DATA_DIR=/app/data and CONFIG_DIR=/app/config.
# DATA_DIR=./data
# CONFIG_DIR=./config

# ---- dashboard ----
# Where the Streamlit UI finds the API (docker compose overrides this to http://api:8601).
API_URL=http://localhost:8601
# api   = always call the HTTP API at API_URL
# local = run the same FastAPI app in-process (no server needed)
# auto  = try API_URL, fall back to local if it is unreachable
RECONLENS_UI_MODE=auto

# ---- LLM (optional; everything works with LLM_PROVIDER=none) ----
LLM_PROVIDER=none
LLM_API_KEY=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
LLM_NARRATION_MIN_CONFIDENCE=0.7
LLM_NARRATION_BATCH_SIZE=20

# Presets: uncomment one block. LLM_BASE_URL and LLM_MODEL are optional for groq/gemini/openai
# (the defaults below are filled in automatically).
#
# Groq (free tier: https://console.groq.com -> API Keys)
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile        # or llama-3.1-8b-instant for higher rate limits
# LLM_API_KEY=gsk_...
#
# Gemini (OpenAI-compatible endpoint; key from Google AI Studio)
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=...
#
# OpenAI
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
#
# Azure OpenAI (LLM_MODEL is the deployment name)
# LLM_PROVIDER=azure
# LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
# LLM_MODEL=<deployment>
# LLM_API_VERSION=2024-10-21
# LLM_API_KEY=...
